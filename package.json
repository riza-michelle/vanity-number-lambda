{
  "name": "vanity-number-lambda-activity",
  "version": "1.0.0",
  "description": "AWS Lambda that converts connect phone numbers to vanity spellings",
  "type": "module",
  "scripts": {
    "build:layer": "bun run scripts/build-index.ts",
    "typecheck": "tsc --noEmit && biome check src/",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "@middy/core": "^7.9.2",
    "@middy/http-cors": "^7.9.2",
    "@middy/http-error-handler": "^7.9.2",
    "http-errors": "^2.0.1",
    "inversify": "^8.2.3",
    "popular-english-words": "^1.0.2",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/aws-lambda": "^8.10.145",
    "@types/http-errors": "^2.0.5",
    "@types/node": "^26.5.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
